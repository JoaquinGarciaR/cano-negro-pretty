# 1. Base de datos PostgreSQL (Supabase Connection String)
# Para migraciones y transacciones de backend usa el pooler o conexión directa:
# Formato: postgresql://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/cano_negro_pretty?schema=public"

# 2. Servidor y Entorno
PORT=4000
NODE_ENV=production

# 3. Clave Secreta para Tokens JWT (Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET="cano_negro_pretty_secret_jwt_key_2026_cozy_salon"

# 4. Web Push VAPID Keys para Notificaciones Push (iOS / Android / Desktop)
VAPID_PUBLIC_KEY="BGxZcaP2C0wXemKL-nj35uD9yWrSq4ee6SMh4pHuKIzOtY08CbxyYuaN3507efEs9P-ARbUcznuqjhz8_Z1n-qE"
VAPID_PRIVATE_KEY="rqQDbyzH4n1u28PNm6UWl0XA92ivB5rTkDe5UtidEoQ"
